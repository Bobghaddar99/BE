<launch>


<arg name="odom_frame_id"   default="odom"/>
<arg name="base_frame_id"   default="base_link"/>
<arg name="global_frame_id" default="map"/>
<arg name="odom_topic" default="odom" />
<arg name="laser_topic" default="scan" />

<node pkg="move_base" type="move_base" respawn="true" name="move_base" output="screen">
    <rosparam file="$(find turt)/config/costmap_common_params.yaml" command="load" 
ns="global_costmap" />
    <rosparam file="$(find turt)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />   
    <rosparam file="$(find turt)/config/local_costmap_params.yaml" command="load"  ns="local_costmap" />    
    <rosparam file="$(find turt)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find turt)/config/teb_params.yaml" command="load" /> 
     <rosparam file="$(find turt)/config/move_base.yaml" command="load" /> 
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
</node>


</launch>