<launch>

     <!-- Launch the gmapping node -->
     <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
      <param name="base_frame" value="base_link"/>
       <param name="odom_frame" value="odom"/>
       <remap from="scan" to="/scan_filter"/>
       <remap from="map" to="/map"/>
       <param name="map_update_interval" value="0.5"/>
       <param name="maxUrange" value="16.0"/>
       <param name="sigma" value="0.05"/>
       <param name="kernelSize" value="3"/>
       <param name="lstep" value="0.05"/>
       <param name="astep" value="0.05"/>
       <param name="iterations" value="5"/>
       <param name="lsigma" value="0.02"/>
       <param name="ogain" value="3.5"/>
       <param name="lskip" value="0"/>
       <param name="srr" value="0.05"/> <!-- Reduce to reduce noise-->
       <param name="srt" value="0.1"/>  <!-- Reduce to reduce noise-->
       <param name="str" value="0.05"/> <!-- Reduce to reduce noise-->
       <param name="stt" value="0.1"/>  <!-- Reduce to reduce noise-->
       <param name="linearUpdate" value="0"/>
       <param name="angularUpdate" value="0"/>
       <param name="temporalUpdate" value="0.2"/>
       <param name="resampleThreshold" value="0.5"/>
       <param name="particles" value="50"/>
       <param name="xmin" value="-50.0"/> <!-- Increase to Increase boundary-->
       <param name="ymin" value="-50.0"/> <!-- Increase to Increase boundary-->
       <param name="xmax" value="50.0"/>  <!-- Increase to Increase boundary-->
       <param name="ymax" value="50.0"/>  <!-- Increase to Increase boundary-->
       <param name="delta" value="0.05"/> <!-- Lower Resolution when increased-->
       <param name="llsamplerange" value="0.01"/> <!-- Reduced noise -->
       <param name="llsamplestep" value="0.01"/>  <!-- Reduced noise -->
       <param name="lasamplerange" value="0.005"/> <!-- Reduced noise -->
       <param name="lasamplestep" value="0.005"/>  <!-- Reduced noise -->
     </node>
   
    
   
     <!-- Launch Rviz -->


   </launch>
